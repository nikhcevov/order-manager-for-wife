# Production Compose reads .env beside compose.production.yaml.
# On a new deployment copy this to .env; otherwise update your existing .env.
# Replace cache with your Unraid pool name; pre-create media and postgres18.
APP_IMAGE=ghcr.io/nikhcevov/order-manager-for-wife:latest
APP_DATA_DIR=/mnt/cache/appdata/order-manager
NODE_ENV=production
HOST=0.0.0.0
PORT=4893
MEDIA_DIR=/app/var/media

POSTGRES_USER=shop
POSTGRES_DB=shop
POSTGRES_PASSWORD=replace-with-a-strong-password
# Percent-encode reserved characters in the URL password, not POSTGRES_PASSWORD.
DATABASE_URL=postgresql://shop:replace-with-a-strong-password@db:5432/shop

BOT_TOKEN=replace-with-botfather-token
SELLER_IDS=replace-with-your-telegram-numeric-id
SHOP_CURRENCY=USD
PAYMENT_INSTRUCTIONS=Replace with your manual payment instructions
PUBLIC_ORIGIN=https://shop.your-domain.com
HOLD_MINUTES=30
