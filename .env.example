# Copy to .env; use real values for Telegram deployment.
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://shop:replace-with-a-local-password@127.0.0.1:55432/shop
BOT_TOKEN=replace-with-botfather-token
SELLER_IDS=replace-with-your-telegram-numeric-id
SHOP_CURRENCY=USD
PAYMENT_INSTRUCTIONS=Replace with your manual payment instructions
PUBLIC_ORIGIN=http://localhost:5173
MEDIA_DIR=../../var/media
HOLD_MINUTES=30
PORT=3000
HOST=127.0.0.1

# For production Compose settings, use .env.production.example instead.
