{
  "name": "telegram-order-manager",
  "private": true,
  "type": "module",
  "workspaces": ["apps/api", "apps/web"],
  "engines": {"node": ">=24"},
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w apps/api",
    "migrate": "npm run migrate -w apps/api",
    "start": "npm run start -w apps/api"
  },
  "devDependencies": {"concurrently": "^9.2.1", "typescript": "^5.9.3", "@types/node": "^24.0.0"},
  "overrides": {"shell-quote": "^1.12.0"}
}
